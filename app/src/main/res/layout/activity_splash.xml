<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de presentación (Splash Screen) que muestra la imagen de portada -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071638">

    <!-- Imagen de portada de presentación a pantalla completa -->
    <ImageView
        android:id="@+id/imgSplashPortada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Portada de presentación Iluminación Inteligente"
        android:scaleType="centerCrop"
        android:src="@drawable/portada"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barra de progreso de carga sutil sobre la portada -->
    <ProgressBar
        android:id="@+id/progressBarSplash"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="48dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFC107"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
