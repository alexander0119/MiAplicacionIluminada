<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal de tipo ConstraintLayout: permite posicionar elementos mediante restricciones relativas -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Logo de la aplicación (interior) -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:contentDescription="Logo Iluminación Inteligente"
        android:src="@drawable/interior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Incremento 2: Título de la pantalla ubicado debajo del logo -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Iniciar sesión"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogo" />

    <!-- Incremento 3: Campo de texto para ingresar el usuario -->
    <EditText
        android:id="@+id/edtUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:hint="Usuario"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <!-- ════════════════════════════════════════════════════════════
         📌 SECCIÓN 1: Campo de contraseña en el diseño XML
         ════════════════════════════════════════════════════════════
         Este campo captura la contraseña del usuario al iniciar sesión.
         - inputType="textPassword": oculta el texto con puntos (••••••)
         - maxLength="20":  límite máximo de 20 caracteres físicos que
           el usuario puede escribir (el teclado deja de aceptar más).
         - El hint indica al usuario el rango válido (6–20 caracteres).
         ════════════════════════════════════════════════════════════ -->
    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Contraseña (6–20 caracteres)"
        android:inputType="textPassword"
        android:maxLength="20"
        app:layout_constraintEnd_toStartOf="@+id/btnMostrarPassword"
        app:layout_constraintStart_toStartOf="@id/edtUsuario"
        app:layout_constraintTop_toBottomOf="@id/edtUsuario" />

    <!-- Botón para alternar la visibilidad de la contraseña -->
    <ImageButton
        android:id="@+id/btnMostrarPassword"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Mostrar u ocultar contraseña"
        android:onClick="onMostrarPasswordClick"
        android:src="@drawable/ic_visibility_24"
        app:layout_constraintBottom_toBottomOf="@+id/edtPassword"
        app:layout_constraintEnd_toEndOf="@id/edtUsuario"
        app:layout_constraintTop_toTopOf="@+id/edtPassword" />

    <!-- Incremento 5: Casilla de verificación para recordar sesión -->
    <CheckBox
        android:id="@+id/chkRecordarme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Recordarme"
        app:layout_constraintStart_toStartOf="@id/edtPassword"
        app:layout_constraintTop_toBottomOf="@id/edtPassword" />

    <!-- Incremento 6 y 7: Botón de ingresar vinculado a onIngresarClick -->
    <Button
        android:id="@+id/btnIngresar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:onClick="onIngresarClick"
        android:text="Ingresar"
        app:layout_constraintEnd_toEndOf="@id/edtPassword"
        app:layout_constraintStart_toStartOf="@id/edtPassword"
        app:layout_constraintTop_toBottomOf="@id/chkRecordarme" />

    <!-- Botón de Limpiar: resetea campos de usuario, contraseña y recordarme, con fondo rojo y vinculado a onLimpiarClick -->
    <Button
        android:id="@+id/btnLimpiar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF0000"
        android:onClick="onLimpiarClick"
        android:text="Limpiar"
        app:layout_constraintEnd_toEndOf="@+id/btnIngresar"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/btnIngresar"
        app:layout_constraintTop_toBottomOf="@+id/btnIngresar" />

    <!-- Botón para ir a la pantalla de Registro -->
    <Button
        android:id="@+id/btnIrARegistro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#4CAF50"
        android:onClick="onIrARegistroClick"
        android:text="¿No tienes cuenta? Regístrate"
        app:layout_constraintEnd_toEndOf="@+id/btnLimpiar"
        app:layout_constraintStart_toStartOf="@+id/btnLimpiar"
        app:layout_constraintTop_toBottomOf="@+id/btnLimpiar" />

</androidx.constraintlayout.widget.ConstraintLayout>